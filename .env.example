# Template — non contiene credenziali reali, è l'unico file .env committato.
#
# Vite carica automaticamente file diversi in base alla modalità:
#   - `npm run dev`   → modalità "development" → legge .env.development.local
#   - `npm run build` → modalità "production"  → legge .env.production.local
#
# Ogni modalità punta a un PROGETTO FIREBASE DIVERSO, così i dati inseriti
# durante lo sviluppo non finiscono nello stesso Firestore della produzione.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
