# Template — non contiene credenziali reali, è l'unico file .env committato.
#
# Vite carica automaticamente file diversi in base alla modalità:
#   - `npm run dev`   → modalità "development" → legge .env.development.local
#   - `npm run build` → modalità "production"  → legge .env.production.local
#
# Ogni modalità punta a un PROGETTO FIREBASE DIVERSO, così i dati inseriti
# durante lo sviluppo non finiscono nello stesso Firestore della produzione.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (protegge Firebase AI Logic, obbligatorio dal 2026-11-02).
# Produzione: chiave reCAPTCHA Enterprise di tipo Web (Google Cloud › Fraud Defense),
# registrata anche in Firebase › App Check › Apps. Va aggiunta ai secret di GitHub.
VITE_RECAPTCHA_SITE_KEY=
# Solo sviluppo (.env.development.local, mai in produzione): token di debug generato
# dalla console (App Check › Apps › Manage debug tokens). Letto solo con `npm run dev`.
# VITE_APPCHECK_DEBUG_TOKEN=
